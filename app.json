{
  "expo": {
    "name": "Paalalay",
    "slug": "paalalay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "paalalay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "package": "com.paalalay.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E3EFF1",
        "foregroundImage": "./assets/brand/foreground.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3EFF1",
          "image": "./assets/brand/foreground.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to find nearby hospitals and clinics in Google Maps.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Paalalay needs access to your photos to review your prescription.",
          "cameraPermission": "Paalalay needs access to your camera to scan your prescription."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification.png",
          "color": "#0B6E79"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
